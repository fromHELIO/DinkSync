{
  "name": "final-project-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --env-file=.env --watch server.js",
    "db:schema": "node --env-file=.env db/run.js db/schema.sql",
    "db:seed": "node --env-file=.env db/run.js db/seed.sql",
    "db:reset": "npm run db:schema && npm run db:seed"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^4.22.3",
    "pg": "^8.23.1",
    "puppeteer": "^25.13.0"
  }
}
